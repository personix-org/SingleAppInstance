root = true

# Editor formatting only. The enforced style rules — braces on every control-flow statement among
# them — are delivered by the Personix.CodeStyle package as a global AnalyzerConfig, so that they
# fail the build in CI rather than depending on local editor settings.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,config,nuspec,globalconfig}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
