<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Deliberately without <clear />: the machine-level sources stay in effect, which is how a
    developer's local feed supplies Personix packages that are not on nuget.org yet. A CI runner
    has no such source configured, so it resolves everything from nuget.org.
  -->
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
